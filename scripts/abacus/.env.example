# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_CHAT_ID=123456789

# AI Diary storage (Google Drive)
AI_DIARY_ROOT_FOLDER_ID=replace_me
AI_DIARY_SCRIPTS_DIR=/home/ubuntu/ai-diary
AI_DIARY_PYTHON=/opt/computersetup/.pyenv/versions/3.11.6/bin/python3

# Google OAuth files
GOOGLE_CREDENTIALS_FILE=/home/ubuntu/ai-diary/google_credentials.json
GOOGLE_TOKEN_FILE=/home/ubuntu/ai-diary/google_token.json

# Google Calendar
GCAL_INBOX_CALENDAR_ID=replace_me
GCAL_PROCESSED_CALENDAR_ID=replace_me
GCAL_TIMELINE_CALENDAR_NAME=AI Diary Timeline

# Runtime
AI_DIARY_SYNC_TIMEOUT_SECONDS=900
AI_DIARY_LOG_LEVEL=INFO
AI_DIARY_MAX_EVENTS_PER_SYNC=5
